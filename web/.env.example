# Vercel → Project Settings → Environment Variables (Production + Preview)
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.

# URL can match app.json → expo.extra.SUPABASE_URL (dev falls back to that if unset)
SUPABASE_URL=https://afixdzyeybxgcqpbynud.supabase.co

# Required for waitlist inserts — NOT the anon key from app.json
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Optional: restrict POST /api/waitlist to your site(s), comma-separated origins
# WAITLIST_ALLOWED_ORIGINS=https://skinsense.app,https://www.skinsense.app
