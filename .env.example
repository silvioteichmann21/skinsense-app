# Copy values into app.json → expo.extra (Expo reads these at build time).
# Restart `npm start` after changing app.json.

# Supabase (required for sign up / sign in)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Optional custom API (scan sync fallback)
API_BASE_URL=https://api-dev.skinsense.app/v1

# Optional (future auth / analytics)
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# MIXPANEL_TOKEN=
# SENTRY_DSN=
